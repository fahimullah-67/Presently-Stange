# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/presently
MONGODB_TEST_URI=mongodb://localhost:27017/presently-test

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_CREDENTIALS=true

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Gmail OTP & Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@presently.com

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:5173

# Zoom SDK Configuration (Complete)
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# AWS S3 (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=presently-bucket

# Google Meet API (Optional)
GOOGLE_MEET_API_KEY=your_google_meet_key

# Payment Configuration (Stripe - Optional)
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_PUBLIC_KEY=your_stripe_public_key

# App Configuration
APP_NAME=Presently
APP_VERSION=1.0.0
APP_URL=http://localhost:5000
